# Copy to .env on the EC2 instance and fill in the real values. Do NOT commit .env.
# Note the driver is postgresql+psycopg (psycopg 3), not bare postgresql,
# because requirements.txt pins psycopg[binary] (v3). SQLAlchemy needs the
# explicit +psycopg or it looks for psycopg2 and fails.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/hypothesis_log
ALLOWED_ORIGINS=https://d2remctp8dpvdy.cloudfront.net
